/// Logs why the reference flow stopped and answers with a generic failure,
/// so no upstream error text reaches the caller.
fn failure(reason: String) -> HttpResponse {
    log_error("reference.failed", ["reason": reason]);
    HttpResponse { status: 502, body: "reference flow failed" }
}

/// Fetches the issue, asks the reviewer model to summarize it, and posts the
/// summary to the message service. Each `?` passes a failure to the caller.
fn review() -> Result<HttpResponse, String> {
    let repository = config_string("reference.repository")?;
    let github_token = secret("github-token")?;
    let issue = http_request(
        "https://github.example.invalid",
        HttpRequest {
            method: "GET",
            path: "/repos/example/issues/1",
            headers: ["x-reference-repository": repository],
        },
        Some(github_token),
    )?;
    // Model output is raw, nondeterministic, untrusted text.
    let model_output = ai_invoke("reviewer", issue.body)?;
    let summary: String = json_decode(model_output);
    let message_token = secret("message-token")?;
    let message = http_request(
        "https://message.example.invalid",
        HttpRequest {
            method: "POST",
            path: "/messages",
            headers: ["idempotency-key": "reference-delivery"],
            body: summary,
        },
        Some(message_token),
    )?;
    log_info("reference.completed", ["adapter": "reviewer"]);
    Ok(HttpResponse { status: 200, headers: message.headers, body: summary })
}

/// Receives a delivery and runs the reference review flow.
webhook fn handle(request: HttpRequest) -> HttpResponse {
    log_info("reference.received", ["delivery": request.path]);
    match review() {
        Ok(response) => response,
        Err(reason) => failure(reason),
    }
}
