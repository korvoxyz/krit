/// Renders a job into the `render-output` bucket at most once: a redelivered
/// job returns the object already stored under its id. The object write and
/// the checkpoint commit together with the acknowledgement; any `Err` commits
/// nothing and lets the host retry.
queue "render-jobs" fn handle(job: QueueJob) -> Result<String, String> {
    let None = object_get("render-output", job.id)? else Some(previous) => Ok(previous);
    object_put("render-output", job.id, job.body)?;
    checkpoint_put("agent-work", "last-render", job.id)?;
    Ok(job.id)
}
