/// Answers with `body`, naming where it came from in the `x-krit-cache` header.
fn answer(status: Int, cache: String, body: String) -> HttpResponse {
    HttpResponse { status, headers: ["x-krit-cache": cache], body }
}

/// Runs the authoritative lookup with the named search connector and stores
/// the result with an explicit time to live. A failed store is not fatal: the
/// response is still correct, only uncached. Search results are untrusted
/// external input and are returned as data, never executed.
fn lookup(query: String, reason: String) -> HttpResponse {
    let Ok(results) = search_query("docs", query, 3) else
        Err(failure) => answer(503, reason, failure);
    match cache_put("lookups", query, results, 60) {
        Ok(_) => answer(200, reason, results),
        // A cache write failure never changes the answer.
        Err(_) => answer(200, "uncached", results),
    }
}

/// A cached search webhook. The cache is an optimisation, never a source of
/// truth, and every outcome is an explicit value this source handles:
///
///     Ok(Some(value))  a live hit, returned directly
///     Ok(None)         a miss, an expiry, or an eviction, all indistinguishable
///     Err(reason)      a cache outage, which falls back exactly like a miss
webhook fn handle(request: HttpRequest) -> HttpResponse {
    match cache_get("lookups", request.query) {
        Ok(Some(value)) => answer(200, "hit", value),
        Ok(None) => lookup(request.query, "miss"),
        Err(_) => lookup(request.query, "unavailable"),
    }
}
