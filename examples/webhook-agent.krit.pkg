schema = 1

[package]
name = "examples/webhook-agent"
version = "0.2.0"
edition = "2026"
entry = "webhook-agent.krit"
license = "Apache-2.0"

[capabilities]
config = ["reference.repository"]
http = [
    "https://ai.example.invalid",
    "https://github.example.invalid",
    "https://message.example.invalid",
]
ai = ["reviewer"]
logs = true

[secrets.ai-token]
origins = ["https://ai.example.invalid"]

[secrets.github-token]
origins = ["https://github.example.invalid"]

[secrets.message-token]
origins = ["https://message.example.invalid"]
