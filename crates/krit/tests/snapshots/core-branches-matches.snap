core module
entry f0 module-init effects {io.stdout}
bindings
  b0 let value: Option<String>
  b1 match name: String
function f0 $module_init () -> Unit effects {io.stdout}
  block bb0 -> Unit effects {io.stdout}
    v0: fn(String) -> Option<String> effects {} = builtin Some [constructor]
    v1: String = string "ready"
    v2: Option<String> = call v0(v1)
    v3: Unit = bind b0 = v2
    v4: fn(String) -> Unit effects {io.stdout} = builtin println [host-effect]
    v7: String = match-option v2 effects {}
    None
      block bb1 -> String effects {}
        v5: String = string "missing"
        return v5
    Some
      block bb2(m0 b1 v6 name: String) -> String effects {}
        return v6
    v8: Unit = call v4(v7) effects {io.stdout}
    v9: Unit = discard v8
    v10: Unit = unit
    return v10
